generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identification String      @unique @db.VarChar(50)
  name           String      @db.VarChar(150)
  phone          String?     @db.VarChar(30)
  vehicles       Vehicle[]
  workOrders     WorkOrder[]
}

model Vehicle {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId       String             @db.Uuid
  plate            String             @unique @db.VarChar(10)
  brand            String             @db.VarChar(80)
  model            String             @db.VarChar(80)
  year             Int                @db.SmallInt
  isFullyElectric  Boolean            @default(false)
  customer         Customer           @relation(fields: [customerId], references: [id])
  workOrders       WorkOrder[]
  technicalHistory TechnicalHistory[]
}

model WorkOrder {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicleId        String    @db.Uuid
  customerId       String    @db.Uuid
  receptionistId   String    @db.Uuid
  initialComplaint String
  status           String    @default("RECIBIDO") @db.VarChar(30)
  mechanicId       String?   @db.Uuid
  assignedAt       DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)
  vehicle          Vehicle   @relation(fields: [vehicleId], references: [id])
  customer         Customer  @relation(fields: [customerId], references: [id])
  mechanic         Mechanic? @relation(fields: [mechanicId], references: [id])
  quote            Quote?

  @@index([mechanicId])
}

model Quote {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workOrderId String        @unique @map("work_order_id") @db.Uuid
  total       Decimal       @db.Decimal(12, 2)
  currency    String        @default("BOB") @db.Char(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  workOrder   WorkOrder     @relation(fields: [workOrderId], references: [id])
  details     QuoteDetail[]

  @@map("quotes")
}

model QuoteDetail {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId     String   @map("quote_id") @db.Uuid
  description String   @db.VarChar(255)
  itemType    String   @map("item_type") @db.VarChar(20)
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  subtotal    Decimal  @db.Decimal(12, 2)
  quote       Quote    @relation(fields: [quoteId], references: [id])

  @@index([quoteId])
  @@map("quote_details")
}

model Mechanic {
  id         String      @id @db.Uuid
  isActive   Boolean     @default(true)
  workOrders WorkOrder[]
}

model TechnicalHistory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicleId   String   @db.Uuid
  description String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, createdAt(sort: Desc)])
}
