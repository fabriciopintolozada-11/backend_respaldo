generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  username     String   @unique @db.VarChar(80) @map("username")
  passwordHash String   @db.VarChar(255) @map("password_hash")
  fullName     String   @db.VarChar(150) @map("full_name")
  role         String   @db.VarChar(30) @map("role")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt    DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  stockMovements      StockMovement[]
  reportedDiscrepancies InventoryDiscrepancy[]

  @@index([username])
  @@map("users")
}

model Customer {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  identification String      @unique @db.VarChar(50) @map("identification")
  name           String      @db.VarChar(150) @map("name")
  phone          String?     @db.VarChar(30) @map("phone")
  vehicles       Vehicle[]
  workOrders     WorkOrder[]

  @@map("customers")
}

model Vehicle {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  customerId       String             @db.Uuid @map("customer_id")
  plate            String             @unique @db.VarChar(10) @map("license_plate")
  brand            String             @db.VarChar(80) @map("brand")
  model            String             @db.VarChar(80) @map("model")
  year             Int                @db.SmallInt @map("year")
  isFullyElectric  Boolean            @default(false) @map("is_fully_electric")
  customer         Customer           @relation(fields: [customerId], references: [id])
  workOrders       WorkOrder[]
  technicalHistory TechnicalHistory[]

  @@index([plate])
  @@map("vehicles")
}

model WorkOrder {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  vehicleId        String    @db.Uuid @map("vehicle_id")
  customerId       String    @db.Uuid @map("customer_id")
  receptionistId   String    @db.Uuid @map("receptionist_id")
  initialComplaint String @map("initial_complaint")
  status           String    @default("RECIBIDO") @db.VarChar(30) @map("status")
  mechanicId       String?   @db.Uuid @map("mechanic_id")
  assignedAt       DateTime? @db.Timestamptz(6) @map("assigned_at")
  createdAt        DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6) @map("updated_at")
  vehicle          Vehicle   @relation(fields: [vehicleId], references: [id])
  customer         Customer  @relation(fields: [customerId], references: [id])
  mechanic         Mechanic? @relation(fields: [mechanicId], references: [id])
  diagnostic       Diagnostic?
  quote            Quote?
  notifications          Notification[]
  stockMovements         StockMovement[]
  inventoryDiscrepancies InventoryDiscrepancy[]

  @@index([vehicleId])
  @@index([status])
  @@index([mechanicId])
  @@map("work_orders")
}

model SparePart {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  code           String   @unique @db.VarChar(50) @map("code")
  name           String   @db.VarChar(150) @map("name")
  category       String   @default("MOTOR") @db.VarChar(40) @map("category")
  unitPrice      Decimal  @db.Decimal(12, 2) @map("unit_price")
  physicalStock  Int      @default(0) @map("physical_stock")
  availableStock Int      @default(0) @map("available_stock")
  reservedStock  Int      @default(0) @map("reserved_stock")
  isActive       Boolean  @default(true) @map("is_active")
  lastMovementAt DateTime @default(now()) @db.Timestamptz(6) @map("last_movement_at")
  quoteItems     QuotePart[]
  stockMovements StockMovement[]
  discrepancies  InventoryDiscrepancy[]

  @@index([category])
  @@index([name])
  @@index([lastMovementAt])
  @@map("spare_parts")
}

// BE-17: immutable audit trail (kardex) of physical inventory movements.
// Insert-only table: records are never updated or deleted. RN-08.
model StockMovement {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  workOrderId String?   @db.Uuid @map("work_order_id")
  sparePartId String    @db.Uuid @map("spare_part_id")
  userId      String    @db.Uuid @map("user_id")
  quantity    Int       @db.SmallInt @map("quantity")
  type        String    @db.VarChar(20) @map("type")
  reason      String?   @db.Text @map("reason")
  previousPhysicalStock Int? @map("previous_physical_stock")
  newPhysicalStock Int? @map("new_physical_stock")
  createdAt   DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id])
  sparePart   SparePart @relation(fields: [sparePartId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@index([workOrderId])
  @@index([sparePartId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("stock_movements")
}

model Quote {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  workOrderId    String      @unique @db.Uuid @map("work_order_id")
  laborItems     Json?       @map("labor_items")
  laborSubtotal  Decimal?    @db.Decimal(12, 2) @map("labor_subtotal")
  partsSubtotal  Decimal?    @db.Decimal(12, 2) @map("parts_subtotal")
  total          Decimal     @db.Decimal(12, 2) @map("total")
  currency       String      @default("BOB") @db.Char(3) @map("currency")
  createdAt      DateTime    @default(now()) @db.Timestamptz(6) @map("created_at")
  workOrder      WorkOrder   @relation(fields: [workOrderId], references: [id])
  parts          QuotePart[]
  details        QuoteDetail[]
  approvals      QuoteApproval[]

  @@map("quotes")
}

model QuotePart {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  quoteId     String    @db.Uuid @map("quote_id")
  sparePartId String    @db.Uuid @map("spare_part_id")
  quantity    Int       @db.SmallInt
  unitPrice   Decimal   @db.Decimal(12, 2) @map("unit_price")
  subtotal    Decimal   @db.Decimal(12, 2) @map("subtotal")
  status      String    @default("PROPOSED") @db.VarChar(20) @map("status")
  quote       Quote     @relation(fields: [quoteId], references: [id])
  sparePart   SparePart @relation(fields: [sparePartId], references: [id])

  @@unique([quoteId, sparePartId])
  @@map("quote_parts")
}

model QuoteApproval {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId      String   @db.Uuid @map("quote_id")
  decision     String   @db.VarChar(20) @map("decision")
  channel      String?  @db.VarChar(20) @map("channel")
  customerName String?  @db.VarChar(150) @map("customer_name")
  notes        String?  @db.Text @map("notes")
  reason       String?  @db.Text @map("reason")
  recordedBy   String   @db.Uuid @map("recorded_by")
  createdAt    DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  quote        Quote    @relation(fields: [quoteId], references: [id])

  @@index([quoteId, createdAt(sort: Desc)])
  @@map("quote_approvals")
}

model Notification {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId  String    @db.Uuid @map("recipient_id")
  workOrderId  String    @db.Uuid @map("work_order_id")
  type         String    @db.VarChar(40)
  message      String    @db.Text
  readAt       DateTime? @db.Timestamptz(6) @map("read_at")
  createdAt    DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id])

  @@index([recipientId, readAt])
  @@map("notifications")
}

model QuoteDetail {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId     String   @map("quote_id") @db.Uuid
  description String   @db.VarChar(255)
  itemType    String   @map("item_type") @db.VarChar(20)
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  subtotal    Decimal  @db.Decimal(12, 2)
  quote       Quote    @relation(fields: [quoteId], references: [id])

  @@index([quoteId])
  @@map("quote_details")
}

model Diagnostic {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  workOrderId      String   @unique @db.Uuid @map("work_order_id")
  description      String   @map("description")
  suggestedTasks   Json     @map("suggested_tasks")
  suggestedPartIds Json     @map("suggested_part_ids")
  estimatedHours   Decimal  @db.Decimal(8, 2) @map("estimated_hours")
  createdAt        DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  workOrder        WorkOrder @relation(fields: [workOrderId], references: [id])

  @@map("diagnostics")
}

model Mechanic {
  id         String      @id @db.Uuid @map("id")
  isActive   Boolean     @default(true) @map("is_active")
  workOrders WorkOrder[]

  @@map("mechanics")
}

model TechnicalHistory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  vehicleId   String   @db.Uuid @map("vehicle_id")
  description String @map("description")
  createdAt   DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, createdAt(sort: Desc)])
  @@map("technical_histories")
}

// US-13: inventory discrepancy register for auditing physical stock mismatches
// detected by the mechanic when a part is not physically available in the warehouse.
// Insert-only: records are never updated or deleted (BE-17).
model InventoryDiscrepancy {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  workOrderId    String    @db.Uuid @map("work_order_id")
  sparePartId    String    @db.Uuid @map("spare_part_id")
  reportedBy     String    @db.Uuid @map("reported_by")
  quantity       Int       @db.SmallInt @map("quantity")
  reason         String    @db.Text @map("reason")
  status         String    @default("PENDING") @db.VarChar(20) @map("status")
  resolvedAt     DateTime? @db.Timestamptz(6) @map("resolved_at")
  resolvedBy     String?   @db.Uuid @map("resolved_by")
  createdAt      DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  workOrder      WorkOrder @relation(fields: [workOrderId], references: [id])
  sparePart      SparePart @relation(fields: [sparePartId], references: [id])
  reporter       User      @relation(fields: [reportedBy], references: [id])

  @@index([workOrderId])
  @@index([sparePartId])
  @@index([status])
  @@map("inventory_discrepancies")
}
