generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identification String        @unique @db.VarChar(50)
  name           String        @db.VarChar(150)
  phone          String?       @db.VarChar(30)
  vehicles       Vehicle[]
  workOrders     WorkOrder[]
}

model Vehicle {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId      String             @db.Uuid
  plate           String             @unique @db.VarChar(10)
  brand           String             @db.VarChar(80)
  model           String             @db.VarChar(80)
  year            Int                @db.SmallInt
  isFullyElectric Boolean            @default(false)
  customer        Customer           @relation(fields: [customerId], references: [id])
  workOrders      WorkOrder[]
  technicalHistory TechnicalHistory[]
}

model WorkOrder {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicleId        String    @db.Uuid
  customerId       String    @db.Uuid
  receptionistId   String    @db.Uuid
  initialComplaint String
  status           String    @default("RECIBIDO") @db.VarChar(30)
  mechanicId       String?   @db.Uuid
  assignedAt       DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  vehicle          Vehicle   @relation(fields: [vehicleId], references: [id])
  customer         Customer  @relation(fields: [customerId], references: [id])

  @@index([mechanicId])
}

model TechnicalHistory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicleId   String   @db.Uuid
  description String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, createdAt(sort: Desc)])
}
