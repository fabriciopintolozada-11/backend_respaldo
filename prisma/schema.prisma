generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  username     String   @unique @db.VarChar(80) @map("username")
  passwordHash String   @db.VarChar(255) @map("password_hash")
  fullName     String   @db.VarChar(150) @map("full_name")
  role         String   @db.VarChar(30) @map("role")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt    DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@index([username])
  @@map("users")
}

model Customer {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  identification String      @unique @db.VarChar(50) @map("identification")
  name           String      @db.VarChar(150) @map("name")
  phone          String?     @db.VarChar(30) @map("phone")
  vehicles       Vehicle[]
  workOrders     WorkOrder[]

  @@map("customers")
}

model Vehicle {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  customerId       String             @db.Uuid @map("customer_id")
  plate            String             @unique @db.VarChar(10) @map("license_plate")
  brand            String             @db.VarChar(80) @map("brand")
  model            String             @db.VarChar(80) @map("model")
  year             Int                @db.SmallInt @map("year")
  isFullyElectric  Boolean            @default(false) @map("is_fully_electric")
  customer         Customer           @relation(fields: [customerId], references: [id])
  workOrders       WorkOrder[]
  technicalHistory TechnicalHistory[]

  @@index([plate])
  @@map("vehicles")
}

model WorkOrder {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  vehicleId        String    @db.Uuid @map("vehicle_id")
  customerId       String    @db.Uuid @map("customer_id")
  receptionistId   String    @db.Uuid @map("receptionist_id")
  initialComplaint String @map("initial_complaint")
  status           String    @default("RECIBIDO") @db.VarChar(30) @map("status")
  mechanicId       String?   @db.Uuid @map("mechanic_id")
  assignedAt       DateTime? @db.Timestamptz(6) @map("assigned_at")
  createdAt        DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6) @map("updated_at")
  vehicle          Vehicle   @relation(fields: [vehicleId], references: [id])
  customer         Customer  @relation(fields: [customerId], references: [id])
  mechanic         Mechanic? @relation(fields: [mechanicId], references: [id])
  diagnostic       Diagnostic?
  quote            Quote?

  @@index([vehicleId])
  @@index([status])
  @@index([mechanicId])
  @@map("work_orders")
}

model SparePart {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  code           String   @unique @db.VarChar(50) @map("code")
  name           String   @db.VarChar(150) @map("name")
  unitPrice      Decimal  @db.Decimal(12, 2) @map("unit_price")
  isActive       Boolean  @default(true) @map("is_active")
  quoteItems     QuotePart[]

  @@map("spare_parts")
}

model Quote {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  workOrderId    String      @unique @db.Uuid @map("work_order_id")
  laborItems     Json        @map("labor_items")
  laborSubtotal  Decimal     @db.Decimal(12, 2) @map("labor_subtotal")
  partsSubtotal  Decimal     @db.Decimal(12, 2) @map("parts_subtotal")
  total          Decimal     @db.Decimal(12, 2) @map("total")
  currency       String      @default("BOB") @db.Char(3) @map("currency")
  createdAt      DateTime    @default(now()) @db.Timestamptz(6) @map("created_at")
  workOrder      WorkOrder   @relation(fields: [workOrderId], references: [id])
  parts          QuotePart[]

  @@map("quotes")
}

model QuotePart {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  quoteId     String    @db.Uuid @map("quote_id")
  sparePartId String    @db.Uuid @map("spare_part_id")
  quantity    Int       @db.SmallInt
  unitPrice   Decimal   @db.Decimal(12, 2) @map("unit_price")
  subtotal    Decimal   @db.Decimal(12, 2) @map("subtotal")
  quote       Quote     @relation(fields: [quoteId], references: [id])
  sparePart   SparePart @relation(fields: [sparePartId], references: [id])

  @@unique([quoteId, sparePartId])
  @@map("quote_parts")
}

model Diagnostic {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  workOrderId      String   @unique @db.Uuid @map("work_order_id")
  description      String   @map("description")
  suggestedTasks   Json     @map("suggested_tasks")
  suggestedPartIds Json     @map("suggested_part_ids")
  estimatedHours   Decimal  @db.Decimal(8, 2) @map("estimated_hours")
  createdAt        DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  workOrder        WorkOrder @relation(fields: [workOrderId], references: [id])

  @@map("diagnostics")
}

model Mechanic {
  id         String      @id @db.Uuid @map("id")
  isActive   Boolean     @default(true) @map("is_active")
  workOrders WorkOrder[]

  @@map("mechanics")
}

model TechnicalHistory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  vehicleId   String   @db.Uuid @map("vehicle_id")
  description String @map("description")
  createdAt   DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, createdAt(sort: Desc)])
  @@map("technical_histories")
}
